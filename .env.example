# Faceless YouTube Multi-Agent Studio - Configuration

# App Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
AUTONOMY_LEVEL=1  # 0: Manual, 1: Script + Final Video human gate, 2: Gate on QA fail only, 3: Fully autonomous

# LLM Providers (Blueprint recommends Claude for scripting/critique, fast models for extraction)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_STRONG_MODEL=claude-3-5-sonnet-latest
DEFAULT_FAST_MODEL=claude-3-5-haiku-latest

# Databases & Queues
MONGODB_URI=mongodb://localhost:27017/faceless_studio
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Storage (R2 / S3 / Local)
STORAGE_BACKEND=local  # 'local', 's3', or 'r2'
STORAGE_DIR=./data/media
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# Search Provider (Tavily, SerpApi, or Brave)
SEARCH_PROVIDER=tavily  # 'tavily', 'serpapi', 'mock'
TAVILY_API_KEY=
SERPAPI_API_KEY=

# TTS Providers
# Indian Language Support: Sarvam Bulbul v3 is recommended in the blueprint
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# YouTube API
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_STORAGE_PATH=./data/tokens

# Stock Footage & Media APIs (Coverr & Pixabay)
COVERR_API_KEY=
PIXABAY_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

